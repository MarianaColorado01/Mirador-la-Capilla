{
  "name": "@mirador/server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor local del PC de caja: API REST + SQLite + Socket.IO",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:reset": "tsx src/db/reset.ts",
